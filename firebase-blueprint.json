{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with marketplace role and activation status",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "name": { "type": "string", "maxLength": 100, "description": "Full name" },
        "email": { "type": "string", "format": "email", "maxLength": 150, "description": "User email address" },
        "mobile": { "type": "string", "maxLength": 30, "description": "User phone/mobile number" },
        "city": { "type": "string", "maxLength": 50, "description": "City of residence" },
        "area": { "type": "string", "maxLength": 100, "description": "Local neighborhood or area" },
        "role": { "type": "string", "enum": ["user", "admin", "super_admin"], "description": "User RBAC role" },
        "activationStatus": { "type": "string", "enum": ["pending", "active", "rejected", "suspended"], "description": "Seller activation status" },
        "isVerified": { "type": "boolean", "description": "Whether the seller has a verified badge" },
        "createdAt": { "type": "string", "description": "Account registration timestamp" }
      },
      "required": ["uid", "name", "email", "role", "activationStatus"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrative reference document",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email", "description": "Admin email" },
        "role": { "type": "string", "enum": ["admin", "super_admin"], "description": "Admin level" },
        "grantedAt": { "type": "string", "description": "Timestamp when admin privilege was granted" }
      },
      "required": ["email", "role"]
    },
    "Listing": {
      "title": "Listing",
      "description": "Marketplace product or classified item listing",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200, "description": "Listing title" },
        "price": { "type": "number", "description": "Price in PKR" },
        "categoryId": { "type": "number", "description": "Category numerical ID" },
        "categoryName": { "type": "string", "maxLength": 100, "description": "Category display name" },
        "description": { "type": "string", "maxLength": 5000, "description": "Full product description" },
        "images": { "type": "array", "description": "Image URLs from Cloud Storage" },
        "city": { "type": "string", "maxLength": 50, "description": "City of listing" },
        "area": { "type": "string", "maxLength": 100, "description": "Area or neighborhood" },
        "condition": { "type": "string", "enum": ["New", "Used", "Refurbished", "Like New"], "description": "Item condition" },
        "userId": { "type": "string", "maxLength": 128, "description": "UID of seller" },
        "sellerName": { "type": "string", "maxLength": 100, "description": "Seller name" },
        "sellerPhone": { "type": "string", "maxLength": 30, "description": "Seller contact number" },
        "sellerVerified": { "type": "boolean", "description": "Verified seller flag" },
        "views": { "type": "number", "description": "Total view count" },
        "isFeatured": { "type": "boolean", "description": "Featured priority listing" },
        "status": { "type": "string", "enum": ["published", "pending", "disabled", "rejected"], "description": "Listing lifecycle status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "price", "categoryId", "city", "userId", "status"]
    },
    "Job": {
      "title": "Job",
      "description": "Employment or labor requirement listing",
      "type": "object",
      "properties": {
        "title": { "type": "string", "maxLength": 200, "description": "Job title" },
        "postType": { "type": "string", "enum": ["need_job", "need_worker"], "description": "Job seeking vs hiring" },
        "category": { "type": "string", "maxLength": 100, "description": "Employment category" },
        "skills": { "type": "string", "maxLength": 300, "description": "Required or offered skills" },
        "salaryOrPayment": { "type": "string", "maxLength": 100, "description": "Offered wage or salary" },
        "city": { "type": "string", "maxLength": 50, "description": "City" },
        "area": { "type": "string", "maxLength": 100, "description": "Area" },
        "description": { "type": "string", "maxLength": 3000, "description": "Job details" },
        "phone": { "type": "string", "maxLength": 30, "description": "Contact phone" },
        "whatsapp": { "type": "string", "maxLength": 30, "description": "WhatsApp contact" },
        "userId": { "type": "string", "maxLength": 128, "description": "Poster UID" },
        "status": { "type": "string", "enum": ["published", "disabled"], "description": "Publication status" },
        "createdAt": { "type": "string", "description": "Creation timestamp" }
      },
      "required": ["title", "postType", "city", "userId"]
    },
    "ActivationPayment": {
      "title": "ActivationPayment",
      "description": "Seller Rs. 1,000 one-time activation payment proof",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "UID of the applicant seller" },
        "userName": { "type": "string", "maxLength": 100, "description": "Seller applicant name" },
        "userPhone": { "type": "string", "maxLength": 30, "description": "Seller contact phone" },
        "userCity": { "type": "string", "maxLength": 50, "description": "Seller city" },
        "amount": { "type": "number", "description": "Amount paid in PKR (e.g. 1000)" },
        "method": { "type": "string", "maxLength": 50, "description": "Payment method used (e.g. EasyPaisa, JazzCash)" },
        "senderNumber": { "type": "string", "maxLength": 30, "description": "Sender account phone number" },
        "transactionId": { "type": "string", "maxLength": 100, "description": "Transaction reference ID" },
        "paymentScreenshot": { "type": "string", "description": "Screenshot URL of transaction receipt" },
        "whatsappScreenshot": { "type": "string", "description": "Screenshot URL of WhatsApp follow proof" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"], "description": "Verification status" },
        "createdAt": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["userId", "amount", "method", "senderNumber", "transactionId", "status"]
    },
    "CollegeAd": {
      "title": "CollegeAd",
      "description": "College admissions and institutional banner ad",
      "type": "object",
      "properties": {
        "institute_name": { "type": "string", "maxLength": 200, "description": "Institution name" },
        "institute_type": { "type": "string", "maxLength": 50, "description": "Public or private" },
        "tagline": { "type": "string", "maxLength": 300, "description": "Promotion tagline" },
        "location": { "type": "string", "maxLength": 150, "description": "Location description" },
        "city": { "type": "string", "maxLength": 50, "description": "City" },
        "phone": { "type": "string", "maxLength": 30, "description": "Admission office phone" },
        "whatsapp": { "type": "string", "maxLength": 30, "description": "WhatsApp number" },
        "courses_offered": { "type": "array", "description": "List of available degree and diploma courses" },
        "status": { "type": "string", "enum": ["APPROVED", "PENDING", "REJECTED"], "description": "Admin approval status" },
        "views": { "type": "number", "description": "Ad views count" },
        "submitted_at": { "type": "string", "description": "Submission timestamp" }
      },
      "required": ["institute_name", "city", "status"]
    },
    "Favorite": {
      "title": "Favorite",
      "description": "Saved favorite listing reference",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "User UID who favorited" },
        "listingId": { "type": "string", "maxLength": 128, "description": "ID of favorited listing" },
        "createdAt": { "type": "string", "description": "Favorited timestamp" }
      },
      "required": ["userId", "listingId"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer review and rating for a seller",
      "type": "object",
      "properties": {
        "sellerId": { "type": "string", "maxLength": 128, "description": "UID of reviewed seller" },
        "reviewerId": { "type": "string", "maxLength": 128, "description": "UID of reviewer" },
        "reviewerName": { "type": "string", "maxLength": 100, "description": "Name of reviewer" },
        "rating": { "type": "number", "description": "Rating score between 1 and 5" },
        "comment": { "type": "string", "maxLength": 1000, "description": "Review comment" },
        "status": { "type": "string", "enum": ["published", "pending", "rejected"], "description": "Moderation status" },
        "createdAt": { "type": "string", "description": "Review timestamp" }
      },
      "required": ["sellerId", "reviewerId", "rating", "comment", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification item",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "maxLength": 128, "description": "Target user UID" },
        "title": { "type": "string", "maxLength": 200, "description": "Notification title" },
        "message": { "type": "string", "maxLength": 1000, "description": "Notification body" },
        "isRead": { "type": "boolean", "description": "Read status" },
        "type": { "type": "string", "maxLength": 50, "description": "Notification category" },
        "link": { "type": "string", "maxLength": 300, "description": "Destination route or URL" },
        "createdAt": { "type": "string", "description": "Notification timestamp" }
      },
      "required": ["userId", "title", "message", "isRead"]
    },
    "SiteSettings": {
      "title": "SiteSettings",
      "description": "Global website configuration and contact information",
      "type": "object",
      "properties": {
        "siteName": { "type": "string", "maxLength": 100, "description": "Website title" },
        "sitePhone": { "type": "string", "maxLength": 30, "description": "Customer support phone" },
        "siteEmail": { "type": "string", "maxLength": 100, "description": "Customer support email" },
        "activationFee": { "type": "number", "description": "Seller activation fee" },
        "easyPaisaNumber": { "type": "string", "maxLength": 30, "description": "Official EasyPaisa number" },
        "jazzCashNumber": { "type": "string", "maxLength": 30, "description": "Official JazzCash number" },
        "updatedAt": { "type": "string", "description": "Last updated timestamp" }
      },
      "required": ["siteName"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles keyed by Firebase Auth UID"
    },
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Trusted admin role lookup document"
    },
    "/listings/{listingId}": {
      "schema": { "$ref": "#/entities/Listing" },
      "description": "Marketplace classified listings"
    },
    "/jobs/{jobId}": {
      "schema": { "$ref": "#/entities/Job" },
      "description": "Employment and labor exchange posts"
    },
    "/activation_payments/{paymentId}": {
      "schema": { "$ref": "#/entities/ActivationPayment" },
      "description": "Seller activation fee proofs awaiting administrator verification"
    },
    "/colleges/{collegeId}": {
      "schema": { "$ref": "#/entities/CollegeAd" },
      "description": "College and educational campus admission advertisements"
    },
    "/favorites/{favoriteId}": {
      "schema": { "$ref": "#/entities/Favorite" },
      "description": "Saved favorite listing references"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Verified seller reviews and ratings"
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notification inbox"
    },
    "/settings/{settingDoc}": {
      "schema": { "$ref": "#/entities/SiteSettings" },
      "description": "Global marketplace settings and announcement rules"
    }
  }
}
